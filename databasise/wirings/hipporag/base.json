{
  "wiring_id": "hipporag-base",
  "title": "HippoRAG 2 base wiring (the 13 governing positions of docs/system-model/wirings/hipporag-base.json: 06-01's 5-node query-side chain, 06-02's 3 index-side positions, 06-05's 4 graph-construction positions completing the index side, and 06-07's dpr-fallback closing the query side; plus the recorded 14th node qa, Phase 12 D-19)",
  "wiring_version": "1",
  "nodes": {
    "chunk-embed": {
      "component": "hipporag/chunker-embedder@0.1.0",
      "kind": "embedder",
      "effects": ["calls_embedding", "writes_vector", "writes_kv"],
      "deps": []
    },
    "openie": {
      "component": "hipporag/openie-extractor@0.1.0",
      "kind": "extractor",
      "effects": ["calls_llm"],
      "config": { "max_concurrency": 4 },
      "deps": ["chunk-embed"]
    },
    "entity-fact-embed": {
      "component": "hipporag/entity-fact-embedder@0.1.0",
      "kind": "embedder",
      "effects": ["calls_embedding", "writes_vector", "writes_kv"],
      "deps": ["openie"]
    },
    "fact-edges": {
      "component": "hipporag/fact-edge-builder@0.1.0",
      "kind": "extractor",
      "effects": [],
      "deps": ["openie"]
    },
    "passage-edges": {
      "component": "hipporag/passage-edge-builder@0.1.0",
      "kind": "extractor",
      "effects": [],
      "deps": ["openie"]
    },
    "synonymy-edges": {
      "component": "hipporag/synonymy-edge-builder@0.1.0",
      "kind": "extractor",
      "effects": ["reads_vector"],
      "config": {
        "synonymy_top_k": 5,
        "synonymy_threshold": 0.8
      },
      "deps": ["entity-fact-embed"]
    },
    "graph-augment-persist": {
      "component": "hipporag/graph-materializer@0.1.0",
      "kind": "extractor",
      "effects": ["writes_graph", "writes_artifact"],
      "deps": ["fact-edges", "passage-edges", "synonymy-edges"]
    },
    "fact-score": {
      "component": "hipporag/fact-scorer@0.1.0",
      "kind": "retriever",
      "effects": ["reads_vector", "calls_embedding"],
      "deps": []
    },
    "fact-filter": {
      "component": "hipporag/fact-filter@0.1.0",
      "kind": "ranker-reranker",
      "effects": ["calls_llm"],
      "config": {
        "linking_top_k": 5,
        "guards": [
          {
            "name": "zero_surviving_facts_dpr_fallback",
            "evaluating_node": "fact-filter",
            "value_when_not_fired": false,
            "granularity": "per-query"
          }
        ]
      },
      "deps": ["fact-score"]
    },
    "dpr-fallback": {
      "component": "hipporag/dpr-fallback@0.1.0",
      "kind": "retriever",
      "effects": ["reads_vector"],
      "deps": ["fact-filter", "fact-score"]
    },
    "reset-vector-join": {
      "component": "hipporag/reset-vector-join@0.1.0",
      "kind": "join",
      "effects": ["reads_vector", "reads_kv"],
      "config": {
        "arity": 2,
        "passage_node_weight": 1.0
      },
      "deps": ["fact-filter", "fact-score"]
    },
    "ppr": {
      "component": "hipporag/ppr-retriever@0.1.0",
      "kind": "retriever",
      "effects": ["reads_graph"],
      "config": {
        "damping": 0.5
      },
      "deps": ["reset-vector-join"]
    },
    "assemble-result": {
      "component": "hipporag/result-assembler@0.1.0",
      "kind": "assembler",
      "effects": ["reads_kv"],
      "config": {
        "top_k": 5,
        "guards": [
          {
            "name": "empty_ppr_dpr_stand_in",
            "evaluating_node": "assemble-result",
            "value_when_not_fired": false,
            "granularity": "per-query"
          }
        ]
      },
      "deps": ["ppr", "dpr-fallback", "fact-filter"]
    },
    "qa": {
      "component": "hipporag/qa-reader@0.1.0",
      "kind": "generator",
      "effects": ["calls_llm"],
      "deps": ["assemble-result"]
    }
  },
  "recipe": { "chunker": "chunk-embed", "embedding": "chunk-embed", "extraction": "openie" },
  "harnesses": [],
  "provides": ["qa"],
  "consumes_query": ["fact-score", "fact-filter", "reset-vector-join", "dpr-fallback", "qa"],
  "evidence_position": { "node": "assemble-result", "namespace": "hipporag-chunks" },
  "store_namespaces": { "kv": "hipporag-text-chunks", "graph": "hipporag-graph" }
}
