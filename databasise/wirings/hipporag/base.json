{
  "wiring_id": "hipporag-base",
  "title": "HippoRAG 2 base wiring (all 13 of docs/system-model/wirings/hipporag-base.json's positions: 06-01's 5-node query-side chain, 06-02's 3 index-side positions, 06-05's 4 graph-construction positions completing the index side, and 06-07's dpr-fallback closing the query side)",
  "wiring_version": "1",
  "nodes": {
    "chunk-embed": {
      "component": "hipporag/chunker-embedder@0.1.0",
      "kind": "embedder",
      "effects": ["calls_embedding", "writes_vector", "writes_kv"],
      "deps": []
    },
    "openie": {
      "component": "hipporag/openie-extractor@0.1.0",
      "kind": "extractor",
      "effects": ["calls_llm"],
      "deps": ["chunk-embed"]
    },
    "entity-fact-embed": {
      "component": "hipporag/entity-fact-embedder@0.1.0",
      "kind": "embedder",
      "effects": ["calls_embedding", "writes_vector"],
      "config": { "namespaces": ["entities", "facts"] },
      "deps": ["openie"]
    },
    "fact-edges": {
      "component": "hipporag/fact-edge-builder@0.1.0",
      "kind": "extractor",
      "effects": [],
      "deps": ["openie"]
    },
    "passage-edges": {
      "component": "hipporag/passage-edge-builder@0.1.0",
      "kind": "extractor",
      "effects": [],
      "deps": ["openie"]
    },
    "synonymy-edges": {
      "component": "hipporag/synonymy-edge-builder@0.1.0",
      "kind": "extractor",
      "effects": ["reads_vector"],
      "config": {
        "declared_capability": "§14.2 Vector self-KNN [PARTS-02 H1]",
        "guard": "num_new_chunks > 0",
        "synonymy_top_k": 5,
        "synonymy_threshold": 0.8
      },
      "deps": ["entity-fact-embed"]
    },
    "graph-augment-persist": {
      "component": "hipporag/graph-materializer@0.1.0",
      "kind": "extractor",
      "effects": ["writes_graph", "writes_artifact"],
      "config": {
        "declared_capability": "§14.2 Graph bulk-export"
      },
      "deps": ["fact-edges", "passage-edges", "synonymy-edges"]
    },
    "fact-score": {
      "component": "hipporag/fact-scorer@0.1.0",
      "kind": "retriever",
      "effects": ["reads_vector", "calls_embedding"],
      "deps": []
    },
    "fact-filter": {
      "component": "hipporag/fact-filter@0.1.0",
      "kind": "ranker-reranker",
      "effects": ["calls_llm"],
      "config": {
        "linking_top_k": 5,
        "guards": [
          {
            "name": "zero_surviving_facts_dpr_fallback",
            "evaluating_node": "fact-filter",
            "value_when_not_fired": false,
            "granularity": "per-query"
          }
        ]
      },
      "deps": ["fact-score"]
    },
    "dpr-fallback": {
      "component": "hipporag/dpr-fallback@0.1.0",
      "kind": "retriever",
      "effects": ["calls_embedding", "reads_vector"],
      "deps": ["fact-filter"]
    },
    "reset-vector-join": {
      "component": "hipporag/reset-vector-join@0.1.0",
      "kind": "join",
      "effects": ["reads_vector", "calls_embedding", "reads_kv"],
      "config": {
        "socket_shape": "ref-keyed vector-sum, per CONTRACT.md §13.3's H2 repair",
        "arm_precedence": "disjoint-support sum, order-insensitive — phrase_weights/passage_weights resolve to disjoint vertex indices",
        "apportionment_policy": "n/a - non-effectful join in the budget sense, no token spend at this node",
        "arity": 2,
        "passage_node_weight": 1.0
      },
      "deps": ["fact-filter"]
    },
    "ppr": {
      "component": "hipporag/ppr-retriever@0.1.0",
      "kind": "retriever",
      "effects": ["reads_graph"],
      "config": {
        "declared_capability": "§14.2 Graph bulk-export",
        "readback": "partitioned — passage-node vertex subset only",
        "damping": 0.5
      },
      "deps": ["reset-vector-join"]
    },
    "assemble-result": {
      "component": "hipporag/result-assembler@0.1.0",
      "kind": "assembler",
      "effects": ["reads_kv"],
      "config": {
        "order_policy": "hipporag-doc-score-order"
      },
      "deps": ["ppr", "dpr-fallback", "fact-filter"]
    }
  },
  "recipe": { "chunker": "chunk-embed", "embedding": "chunk-embed", "extraction": "openie" },
  "harnesses": [],
  "provides": ["assemble-result"],
  "consumes_query": ["fact-score", "reset-vector-join", "dpr-fallback"],
  "evidence_position": { "node": "assemble-result", "namespace": "hipporag-chunks" },
  "store_namespaces": { "kv": "hipporag-text-chunks", "graph": "hipporag-graph" }
}
