{
  "patch_format": "RFC 6902 JSON Patch",
  "patch_format_reason": "Subtractive — removes entity-lookup, entity-hydrate-expand, chunk-vector — so per CONTRACT.md:182 this MUST be an RFC 6902 operation list, not an RFC 7386 merge-patch.",
  "base": "lightrag-base.json",
  "operations": [
    { "op": "remove", "path": "/nodes/entity-lookup" },
    { "op": "remove", "path": "/nodes/entity-hydrate-expand" },
    { "op": "remove", "path": "/nodes/chunk-vector" },
    { "op": "replace", "path": "/evidence_position", "value": { "node": "assemble", "namespace": "chunks" } },
    { "op": "replace", "path": "/nodes/join-entities/deps", "value": ["relation-hydrate-expand"] },
    { "op": "replace", "path": "/nodes/join-entities/config/arm_precedence",
      "value": "relation-hydrate-expand-only, degenerate 1-ary join — global is not entity-free: relation-hydrate-expand's endpoint-expansion sub-step emits entities too (operate.py:6115-6146)" },
    { "op": "replace", "path": "/nodes/join-relations/deps", "value": ["relation-hydrate-expand"] },
    { "op": "replace", "path": "/nodes/join-relations/config/arm_precedence",
      "value": "relation-hydrate-expand-only, degenerate 1-ary join (relation-half)" },
    { "op": "replace", "path": "/nodes/join-chunks/deps", "value": ["chunk-sel-kg"] },
    { "op": "replace", "path": "/nodes/join-chunks/config", "value": {
      "socket_shape": "List[List[X]] -> List[X]",
      "arity": 1,
      "arm_precedence": "chunk-sel-kg-only, degenerate 1-ary join",
      "apportionment_policy": "n/a - non-effectful join, no budget spent at this node"
    } }
  ],
  "resulting_node_id_set": [
    "keywords", "embedder-query", "relation-lookup", "relation-hydrate-expand",
    "join-entities", "join-relations", "budget-entities", "budget-relations",
    "chunk-sel-kg", "join-chunks", "heading-backfill", "rerank", "assemble",
    "generate", "embedder-index"
  ]
}
