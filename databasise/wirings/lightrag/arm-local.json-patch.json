{
  "patch_format": "RFC 6902 JSON Patch",
  "patch_format_reason": "Subtractive — removes relation-lookup, relation-hydrate-expand, chunk-vector — so per CONTRACT.md:182 this MUST be an RFC 6902 operation list, not an RFC 7386 merge-patch.",
  "base": "lightrag-base.json",
  "operations": [
    { "op": "replace", "path": "/wiring_id", "value": "lightrag-local" },
    { "op": "add", "path": "/arm_id", "value": "local" },
    { "op": "remove", "path": "/nodes/relation-lookup" },
    { "op": "remove", "path": "/nodes/relation-hydrate-expand" },
    { "op": "remove", "path": "/nodes/chunk-vector" },
    { "op": "replace", "path": "/evidence_position", "value": { "node": "assemble", "namespace": "chunks" } },
    { "op": "replace", "path": "/nodes/join-entities/deps", "value": ["entity-hydrate-expand"] },
    { "op": "replace", "path": "/nodes/join-entities/config/arm_precedence",
      "value": "entity-hydrate-expand-only, degenerate 1-ary join (entity-half)" },
    { "op": "replace", "path": "/nodes/join-relations/deps", "value": ["entity-hydrate-expand"] },
    { "op": "replace", "path": "/nodes/join-relations/config/arm_precedence",
      "value": "entity-hydrate-expand-only, degenerate 1-ary join — local is not relation-free: entity-hydrate-expand's edge-expansion sub-step emits relations too (operate.py:5841-5895)" },
    { "op": "replace", "path": "/nodes/join-chunks/deps", "value": ["chunk-sel-kg"] },
    { "op": "replace", "path": "/nodes/join-chunks/config", "value": {
      "socket_shape": "List[List[X]] -> List[X]",
      "arity": 1,
      "arm_precedence": "chunk-sel-kg-only, degenerate 1-ary join"
    } }
  ],
  "resulting_node_id_set": [
    "keywords", "embedder-query", "entity-lookup", "entity-hydrate-expand",
    "join-entities", "join-relations", "budget-entities", "budget-relations",
    "chunk-sel-kg", "join-chunks", "heading-backfill", "rerank", "assemble",
    "generate", "embedder-index"
  ]
}
