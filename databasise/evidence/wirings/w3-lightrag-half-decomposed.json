{
  "wiring_id": "w3-lightrag-half-decomposed",
  "title": "Half-decomposed full LightRAG",
  "nodes": {
    "ingest": {
      "component": "lightrag/full-ingest@0.1.0",
      "kind": "opaque",
      "effects": ["calls_llm", "writes_artifact", "reads_kv", "reads_graph"],
      "deps": []
    },
    "keywords": {
      "component": "lightrag/keyword-extractor@0.1.0",
      "kind": "rewriter",
      "effects": ["calls_llm"],
      "deps": ["ingest"]
    },
    "embedder-query": {
      "component": "lightrag/embedder-query@0.1.0",
      "kind": "embedder",
      "effects": ["calls_embedding"],
      "deps": ["keywords"]
    },
    "entity-lookup": {
      "component": "lightrag/entity-lookup@0.1.0",
      "kind": "retriever",
      "effects": ["reads_vector"],
      "deps": ["embedder-query"]
    },
    "entity-hydrate-expand": {
      "component": "lightrag/entity-hydrate-expand@0.1.0",
      "kind": "retriever",
      "effects": ["reads_graph"],
      "config": { "cardinality_bound": "unbounded" },
      "deps": ["entity-lookup"]
    },
    "join-entities": {
      "component": "lightrag/join-roundrobin@0.1.0",
      "kind": "join",
      "config": {
        "socket_shape": "List[List[X]] -> List[X]",
        "arm_precedence": "entity-hydrate-expand-only, degenerate 1-ary join (entity-half)",
        "apportionment_policy": "n/a - non-effectful join, no budget spent at this node"
      },
      "deps": ["entity-hydrate-expand"]
    },
    "join-relations": {
      "component": "lightrag/join-roundrobin@0.1.0",
      "kind": "join",
      "config": {
        "socket_shape": "List[List[X]] -> List[X]",
        "arm_precedence": "entity-hydrate-expand-only, degenerate 1-ary join — local is not relation-free: entity-hydrate-expand's edge-expansion sub-step emits relations too (operate.py:5841-5895)",
        "apportionment_policy": "n/a - non-effectful join, no budget spent at this node"
      },
      "deps": ["entity-hydrate-expand"]
    },
    "budget-entities": {
      "component": "lightrag/truncator-token-budget@0.1.0",
      "kind": "grader-filter",
      "config": {
        "apportionment_policy": "first-come-over-joined-list",
        "apportioning_node": "budget-entities"
      },
      "deps": ["join-entities"]
    },
    "budget-relations": {
      "component": "lightrag/truncator-token-budget@0.1.0",
      "kind": "grader-filter",
      "config": {
        "apportionment_policy": "first-come-over-joined-list",
        "apportioning_node": "budget-relations"
      },
      "deps": ["join-relations"]
    },
    "chunk-sel-kg": {
      "component": "lightrag/chunk-selector-kg@0.1.0",
      "kind": "retriever",
      "effects": ["reads_kv", "reads_vector"],
      "config": {
        "cardinality_bound": "unbounded",
        "pick_method": "VECTOR",
        "fallback_pick_method": "WEIGHT"
      },
      "deps": ["budget-entities", "budget-relations"]
    },
    "join-chunks": {
      "component": "lightrag/join-roundrobin@0.1.0",
      "kind": "join",
      "config": {
        "socket_shape": "List[List[X]] -> List[X]",
        "arity": 1,
        "arm_precedence": "chunk-sel-kg-only, degenerate 1-ary join",
        "apportionment_policy": "n/a - non-effectful join, no budget spent at this node"
      },
      "deps": ["chunk-sel-kg"]
    },
    "heading-backfill": {
      "component": "lightrag/chunk-heading-backfiller@0.1.0",
      "kind": "grader-filter",
      "effects": ["reads_kv"],
      "deps": ["join-chunks"]
    },
    "rerank": {
      "component": "lightrag/reranker-cross-encoder@0.1.0",
      "kind": "ranker-reranker",
      "effects": ["calls_rerank"],
      "deps": ["heading-backfill"]
    },
    "assemble": {
      "component": "lightrag/assembler-kg-context@0.1.0",
      "kind": "assembler",
      "config": { "order_policy": "kg-template" },
      "deps": ["rerank"]
    },
    "generate": {
      "component": "lightrag/generator-llm@0.1.0",
      "kind": "generator",
      "effects": ["calls_llm"],
      "config": { "priority_class": "query" },
      "deps": ["assemble"]
    },
    "embedder-index": {
      "component": "lightrag/embedder-index@0.1.0",
      "kind": "embedder",
      "effects": ["calls_embedding"],
      "deps": []
    }
  },
  "boundary_knobs": [
    {
      "boundary_id": "w3-knob-ingest-query-boundary",
      "between": "ingest -> query-side",
      "rationale": "the opaque ingest core's boundary against the decomposed query side: ingest can be replaced by a different ingest implementation, or bypassed by a pre-populated store, without changing query-side's own socket"
    }
  ]
}
