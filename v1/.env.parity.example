# Phase 3 parity-arm environment for stock v1 LightRAG (03-02-PLAN.md Task 1).
#
# This file is the readable, secret-free companion to `.env.parity` (gitignored, holds a live
# OpenRouter API key). Every variable name and every non-secret value here matches `.env.parity`
# exactly; only `LLM_BINDING_API_KEY` / `EMBEDDING_BINDING_API_KEY` / `KEYWORD_LLM_BINDING_API_KEY`
# are placeholders.
#
# Pinned decisions this file encodes:
#   D-06  corpus: HotpotQA distractor setting (databasise/tests/fixtures/corpus/)
#   D-07  generator: qwen/qwen3.7-flash via OpenRouter, provider pinned to Alibaba
#         (OpenRouter's own /models/qwen/qwen3.7-flash/endpoints lists exactly one upstream
#         provider for this model as of 2026-08-31, so pinning is a no-op in effect today but
#         still asserted — a second provider appearing later must not silently reroute this run)
#   D-08  keyword-extraction model: same qwen/qwen3.7-flash, same provider pin
#   D-09  (AMENDED, see 03-D09-AMENDMENT.md): embedder is qwen/qwen3-embedding-8b via
#         OpenRouter's embeddings endpoint — NOT a local Ollama endpoint as the original D-09
#         said. Rerank stays disabled (unchanged half of D-09).
#   D-05  storage: Cozo graph + Faiss vector, matching Phase 1's frozen store family — never
#         v1's networkx/nano-vectordb quick-start defaults.

############################
### LLM binding (generator + keyword extraction) — D-07/D-08
############################
LLM_BINDING=openai
LLM_BINDING_HOST=https://openrouter.ai/api/v1
LLM_BINDING_API_KEY=REPLACE_WITH_OPENROUTER_KEY
LLM_MODEL=qwen/qwen3.7-flash
# Provider pin: OpenRouter's own endpoint list for this model names one upstream ("Alibaba").
# allow_fallbacks=false makes a future second provider an explicit config change, not a silent
# reroute mid-run (D-07's stated rationale: "a re-routed provider changes identity mid-run").
OPENAI_LLM_EXTRA_BODY={"provider": {"order": ["Alibaba"], "allow_fallbacks": false}}

KEYWORD_LLM_BINDING=openai
KEYWORD_LLM_BINDING_HOST=https://openrouter.ai/api/v1
KEYWORD_LLM_BINDING_API_KEY=REPLACE_WITH_OPENROUTER_KEY
KEYWORD_LLM_MODEL=qwen/qwen3.7-flash

############################
### Embedding binding — D-09 AMENDED (03-D09-AMENDMENT.md): OpenRouter, not Ollama
############################
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://openrouter.ai/api/v1
EMBEDDING_BINDING_API_KEY=REPLACE_WITH_OPENROUTER_KEY
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIM=4096
# Provider pin for reproducibility (Rule 2 — D-14 wants a run record a second author can
# reproduce): DeepInfra is the cheapest of three live providers for this model at pin time
# and matches Nebius/SiliconFlow's stated bf16/fp8 precision options. Not required by D-09's
# amendment text but consistent with its own reproducibility rationale.
OPENAI_EMBEDDING_EXTRA_BODY={"provider": {"order": ["DeepInfra"], "allow_fallbacks": false}}

############################
### Rerank — disabled (D-09, unchanged half)
############################
RERANK_BINDING=null

############################
### Storage — D-05 (Cozo + Faiss, matching Phase 1's frozen store family)
############################
LIGHTRAG_KV_STORAGE=JsonKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=CozoGraphStorage
LIGHTRAG_VECTOR_STORAGE=FaissVectorDBStorage

############################
### Misc
############################
ENABLE_LLM_CACHE=false
SUMMARY_LANGUAGE=English
