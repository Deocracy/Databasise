*.pyc
.venv/
node_modules/
*.tgz

# GSD runtime sentinels
.gsd/
.env.secrets

# Local scratch — agent worktrees and parity-run stores (233M+, never committed)
.claude/worktrees/
v1/.parity_*/

# Real credentials: pinned parity run config (v1/.env.parity symlinks here).
